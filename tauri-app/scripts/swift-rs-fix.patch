+/// Recursively locate `lib_file` under `root`, preferring the most recently
+/// modified match. Used when the Xcode 27 products-dir heuristics miss: the
+/// archive exists, just not where the layout rules predicted.
+fn find_archive(root: &Path, lib_file: &str) -> Option<PathBuf> {
+    let mut best: Option<(std::time::SystemTime, PathBuf)> = None;
+    let mut stack = vec![root.to_path_buf()];
+    while let Some(dir) = stack.pop() {
+        let Ok(entries) = std::fs::read_dir(&dir) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            let Ok(ft) = entry.file_type() else { continue };
+            if ft.is_dir() {
+                stack.push(path);
+            } else if entry.file_name() == lib_file {
+                let mtime = entry
+                    .metadata()
+                    .and_then(|m| m.modified())
+                    .unwrap_or(std::time::UNIX_EPOCH);
+                if best.as_ref().is_none_or(|(t, _)| mtime > *t) {
+                    best = Some((mtime, path));
+                }
+            }
+        }
+    }
+    best.map(|(_, p)| p).and_then(|p| p.parent().map(Path::to_path_buf))
+}
