+/// The three @_cdecl functions the swift-rs *Rust* crate calls itself
+/// (`retain_object` / `release_object` / `string_from_bytes`) are defined in the
+/// SwiftRs *Swift* library, which SwiftPM embeds into each consumer archive as a
+/// dependency member (`SwiftRs.o`). `globalize_cdecl_symbols` skips dependency
+/// members on purpose — promoting them in every archive would define the same
+/// globals more than once — so on Xcode 27 they stay local `t` and EVERY build
+/// fails with "Undefined symbols: _retain_object, ...".
+///
+/// Promote them in exactly one archive: the package that owns the Swift runtime
+/// (`Tauri` by default, overridable via SWIFT_RS_RUNTIME_PACKAGE). ld resolves
+/// the undefined refs there and never pulls the duplicate member out of a
+/// sibling archive, so no duplicate-symbol error.
+fn globalize_runtime_symbols(archive: &Path, package_name: &str) {
+    const RUNTIME_SYMBOLS: [&str; 3] = ["_retain_object", "_release_object", "_string_from_bytes"];
+
+    let owner = env::var("SWIFT_RS_RUNTIME_PACKAGE").unwrap_or_else(|_| "Tauri".into());
+    if package_name != owner || !archive.exists() {
+        return;
+    }
+    let Some(objcopy) = rustup_llvm_objcopy() else {
+        println!(
+            "cargo:warning=swift-rs: llvm-objcopy not found (run `rustup component add \
+             llvm-tools`); SwiftRs runtime symbols stay internalized on Xcode 27"
+        );
+        return;
+    };
+    // Only promote what is actually present and local — globalizing an absent or
+    // already-global symbol is a no-op, but checking keeps the log honest.
+    let Ok(nm) = Command::new("nm").arg(archive).output() else {
+        return;
+    };
+    let listing = String::from_utf8_lossy(&nm.stdout);
+    let local: Vec<&str> = RUNTIME_SYMBOLS
+        .iter()
+        .copied()
+        .filter(|s| listing.lines().any(|l| l.ends_with(&format!(" t {s}"))))
+        .collect();
+    if local.is_empty() {
+        return;
+    }
+    let mut cmd = Command::new(objcopy);
+    for s in &local {
+        cmd.arg(format!("--globalize-symbol={s}"));
+    }
+    cmd.arg(archive);
+    if cmd.status().map(|s| s.success()).unwrap_or(false) {
+        println!(
+            "cargo:warning=swift-rs: promoted {} SwiftRs runtime symbol(s) in {}",
+            local.len(),
+            archive.display()
+        );
+    }
+}
