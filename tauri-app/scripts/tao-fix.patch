+      _previous_trait_collection: *mut AnyObject,
+    ) {
+      unsafe {
+        let coord_space: *mut AnyObject = msg_send![scene, coordinateSpace];
+        let scene_bounds: CGRect = msg_send![coord_space, bounds];
