       // Dynamically set the delegate class name
       config.setDelegateClass(Some(super::scene::TaoSceneDelegate::class()));
-      Retained::as_ptr(&config) as _
+      // ARC NARC convention: this selector doesn't start with new/alloc/copy/
+      // mutableCopy/init, so the caller (UIKit) expects an autoreleased +0
+      // reference. `Retained::as_ptr(&config)` returns a borrowed pointer; the
+      // owning `Retained` then drops at function end, sending `release` and
+      // deallocating the config before UIKit reads `delegateClass` — a
+      // use-after-free that manifests in release builds as a "(null)"
+      // delegate-class and immediate app-launch termination on iPad.
+      Retained::autorelease_return(config) as _
     }
   }
 
