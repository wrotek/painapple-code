+  // frame it had at scene-attach time and the newly-exposed area paints as
+  // the scene's background (black).
+  #[allow(non_snake_case)]
+  impl TaoSceneDelegate {
+    #[unsafe(method(windowScene:didUpdateCoordinateSpace:interfaceOrientation:traitCollection:))]
