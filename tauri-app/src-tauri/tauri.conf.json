{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pAInapple Code",
  "version": "0.0.0",
  "identifier": "com.boothw.painapple",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "pAInapple Code",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
        "minimumSystemVersion": "15.0"
    }
  }
}
